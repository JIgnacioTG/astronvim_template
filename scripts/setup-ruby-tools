#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TOOL_DIR="$ROOT_DIR/.ruby-tools/3.4.5"
GEMFILE="$TOOL_DIR/Gemfile"
VENDOR_PATH="$TOOL_DIR/vendor/bundle"

. "$ROOT_DIR/scripts/lib/ruby-3.4.5-toolchain"

ensure_ruby() {
  case "$1" in
    system)
      ;;
    rbenv)
      rbenv install -s "$RUBY_345_VERSION"
      ;;
    rvm)
      if ! rvm_ruby_matches; then
        rvm install "$RUBY_345_VERSION"
      fi
      ;;
    *)
      printf '%s\n' "Unknown Ruby manager: $1" >&2
      exit 1
      ;;
  esac
}

ensure_bundler() {
  case "$1" in
    system)
      if ! run_system_ruby_345_gem list -i bundler >/dev/null 2>&1; then
        run_system_ruby_345_gem install bundler
      fi
      ;;
    rbenv)
      if ! RBENV_VERSION="$RUBY_345_VERSION" rbenv exec gem list -i bundler >/dev/null 2>&1; then
        RBENV_VERSION="$RUBY_345_VERSION" rbenv exec gem install bundler
      fi
      ;;
    rvm)
      if ! rvm "$RUBY_345_VERSION" do gem list -i bundler >/dev/null 2>&1; then
        rvm "$RUBY_345_VERSION" do gem install bundler
      fi
      ;;
    *)
      printf '%s\n' "Unknown Ruby manager: $1" >&2
      exit 1
      ;;
  esac
}

bundle_with_manager() {
  local manager="$1"
  shift

  case "$manager" in
    system)
      run_system_ruby_345_bundle "$GEMFILE" "$VENDOR_PATH" "$@"
      ;;
    rbenv)
      RBENV_VERSION="$RUBY_345_VERSION" BUNDLE_GEMFILE="$GEMFILE" BUNDLE_PATH="$VENDOR_PATH" rbenv exec bundle "$@"
      ;;
    rvm)
      BUNDLE_GEMFILE="$GEMFILE" BUNDLE_PATH="$VENDOR_PATH" rvm "$RUBY_345_VERSION" do bundle "$@"
      ;;
    *)
      printf '%s\n' "Unknown Ruby manager: $manager" >&2
      exit 1
      ;;
  esac
}

main() {
  local manager
  manager="$(detect_ruby_345_setup_source)"

  mkdir -p "$VENDOR_PATH"
  cd "$TOOL_DIR"

  ensure_ruby "$manager"
  ensure_bundler "$manager"

  bundle_with_manager "$manager" install
}

main
