#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TOOL_DIR="$ROOT_DIR/.ruby-tools/3.4.5"
GEMFILE="$TOOL_DIR/Gemfile"
RUBY_VERSION="3.4.5"
VENDOR_PATH="$TOOL_DIR/vendor/bundle"

detect_manager() {
  if command -v rbenv >/dev/null 2>&1; then
    printf '%s\n' rbenv
    return
  fi

  if command -v rvm >/dev/null 2>&1; then
    printf '%s\n' rvm
    return
  fi

  printf '%s\n' "Install rbenv or rvm, then run scripts/setup-ruby-tools" >&2
  exit 1
}

ensure_ruby() {
  case "$1" in
    rbenv)
      rbenv install -s "$RUBY_VERSION"
      ;;
    rvm)
      if ! rvm list strings | grep -qx "$RUBY_VERSION"; then
        rvm install "$RUBY_VERSION"
      fi
      ;;
    *)
      printf '%s\n' "Unknown Ruby manager: $1" >&2
      exit 1
      ;;
  esac
}

ensure_bundler() {
  case "$1" in
    rbenv)
      if ! RBENV_VERSION="$RUBY_VERSION" rbenv exec gem list -i bundler >/dev/null 2>&1; then
        RBENV_VERSION="$RUBY_VERSION" rbenv exec gem install bundler
      fi
      ;;
    rvm)
      if ! rvm "$RUBY_VERSION" do gem list -i bundler >/dev/null 2>&1; then
        rvm "$RUBY_VERSION" do gem install bundler
      fi
      ;;
    *)
      printf '%s\n' "Unknown Ruby manager: $1" >&2
      exit 1
      ;;
  esac
}

bundle_with_manager() {
  local manager="$1"
  shift

  case "$manager" in
    rbenv)
      RBENV_VERSION="$RUBY_VERSION" BUNDLE_GEMFILE="$GEMFILE" BUNDLE_PATH="$VENDOR_PATH" rbenv exec bundle "$@"
      ;;
    rvm)
      BUNDLE_GEMFILE="$GEMFILE" BUNDLE_PATH="$VENDOR_PATH" rvm "$RUBY_VERSION" do bundle "$@"
      ;;
    *)
      printf '%s\n' "Unknown Ruby manager: $manager" >&2
      exit 1
      ;;
  esac
}

main() {
  local manager
  manager="$(detect_manager)"

  mkdir -p "$VENDOR_PATH"
  cd "$TOOL_DIR"

  ensure_ruby "$manager"
  ensure_bundler "$manager"

  bundle_with_manager "$manager" install
}

main
