#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TOOL_DIR="$ROOT_DIR/.ruby-tools/3.4.5"
GEMFILE="$TOOL_DIR/Gemfile"
VENDOR_PATH="$TOOL_DIR/vendor/bundle"

. "$ROOT_DIR/scripts/lib/ruby-3.4.5-toolchain"

run_tool() {
  run_with_ruby_345 "$GEMFILE" "$VENDOR_PATH" exec rubocop "$@"
}

run_tool "$@"
